метод МетодыРаботыСоСтрокой()
    пер МояСтрока = "Это моя строка для проверки методов"
    пер Результат: Объект ?
    Результат = МояСтрока.ВВерхнийРегистр()
    Результат = МояСтрока.ВНижнийРегистр()
    Результат = МояСтрока.Перевернуть()
    Результат = МояСтрока.Длина()
    Результат = МояСтрока.ПодстрокаСНачала(5)
    Результат = МояСтрока.ПодстрокаСКонца(3)
    Результат = МояСтрока.Заменить("о", "№")
    Сообщить("Сообщить результат выполнения метода: %Результат")
;
