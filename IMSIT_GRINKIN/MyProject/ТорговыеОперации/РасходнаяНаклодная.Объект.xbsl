@Обработчик
метод ПередЗаписью(До: РасходнаяНаклодная.Данные, ПараметрыЗаписи: РасходнаяНаклодная.ПараметрыЗаписи)
    этот.СуммаДокумента = 0
    для СтрокаТовара из этот.СписокТоваров
        этот.СуммаДокумента += СтрокаТовара.Сумма
    ;
    для СтрокаУслуг из этот.СписокУслуг
        этот.СуммаДокумента += СтрокаУслуг.Сумма
    ;
;